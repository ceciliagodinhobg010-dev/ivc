<%-include('.. /cabecalho.ejs')%>
    <h1>Editar Material</h1>
    <div>
        <a href="/Material/lst">Listar</a>
    </div>
    <div>
        <form method="post">

            <input type="hidden" name="id" value="<%=Material.id%>"><br>

            <label>Título:</label>
            <input type="text" name="titulo" value="<%=Material.titulo%>"><br>

            <label>Descrição:</label>
            <input type="text" name="descricao" value="<%=Material.descricao%>"><br>

            <label>Categoria:</label>
            <input type="text" name="categoria" value="<%= Material.categoria %>"><br>

            <label>Arquivo:</label>
            <input type="text" name="arquivo" value="<%= Material.arquivo %>"><br>

            <label>Capa:</label>
            <input type="text" name="capa" value="<%= Material.capa %>"><br>

            <button type="submit">Cadastrar</button>

        </form>
    </div>

    <%-include('.. /rodape.ejs')%>